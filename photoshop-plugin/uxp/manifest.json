{
  "manifestVersion": 5,
  "id": "com.openai.photoshop.slice.naming",
  "name": "Slice Naming Panel",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "slice-naming-panel",
      "label": {
        "default": "Slice Naming Panel"
      },
      "minimumSize": {
        "width": 360,
        "height": 520
      },
      "maximumSize": {
        "width": 1400,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 820
      },
      "preferredFloatingSize": {
        "width": 460,
        "height": 860
      }
    }
  ]
}
