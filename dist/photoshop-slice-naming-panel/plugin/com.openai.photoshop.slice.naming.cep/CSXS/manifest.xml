<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Version="5.0" ExtensionBundleId="com.openai.photoshop.slice.naming.cep" ExtensionBundleVersion="0.1.0" ExtensionBundleName="Slice Naming Panel">
